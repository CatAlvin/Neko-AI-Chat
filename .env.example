NEKO_DATABASE_URL=sqlite:///./data/neko.db
NEKO_DATA_DIR=data
NEKO_RELEASE_GATE=SIMULATION
NEKO_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# If left empty, an authentication secret is generated locally on first start.
NEKO_SECRET_KEY=
# Set a random connector token before enabling a real local bridge.
NEKO_CONNECTOR_SHARED_TOKEN=
